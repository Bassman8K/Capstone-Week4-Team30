# ══════════════════════════════════════════════════════════════════
# Capstone Team 30 — the ONE env file
#
#   1. Copy to .env:        cp .env.example .env
#   2. Fill in FIREBASE_SERVICE_ACCOUNT_KEY_BASE64 below (ask Jonathan)
#   3. Run the app:         pnpm run dev
#
# That one value is the only thing you need. Everything else is already
# filled in, and STITCH_API_KEY at the bottom is optional tooling the app
# does not need to run.
#
# The Firebase values below are NOT secret. They ship inside the browser
# bundle of the deployed app, so anyone can already read them from the live
# site — Firebase treats the web config as public by design. What actually
# protects the data is Firestore security rules and Authentication.
#
# The blank below IS secret — full admin access to our database. Never
# commit it, never paste it into a group chat.
#
# frontend/.env.local and backend/.env are GENERATED from this file —
# never edit them by hand. Reference: docs/ENV-VARS.md
# Setup guide: docs/RUNNING-THE-APP.md
# ══════════════════════════════════════════════════════════════════

# ── Firebase project ────────────────────────────────────────────────
# Your Firebase project id — must match .firebaserc → projects.default
# Named with the NEXT_PUBLIC_ prefix (like the rest of the web app config
# below) because this exact name is what frontend/.env.local, backend/.env,
# and Vercel's environment variables all use too — same name everywhere,
# nothing gets silently renamed in between.
NEXT_PUBLIC_FIREBASE_PROJECT_ID=capstone-week4-team30

# Service account JSON, base64-encoded. SERVER-ONLY SECRET — never commit.
# REQUIRED — the app cannot sign anyone in without it. Ask Jonathan for the
# value rather than generating your own, so we all share one Firebase project.
# (If you ever do need to generate one:
# Firebase Console → Project settings → Service accounts → Generate new private key)
#   macOS (BSD base64):  base64 -i service-account.json | tr -d '\n'
#   Linux (GNU base64):  base64 -w 0 service-account.json
#   PowerShell:          [Convert]::ToBase64String([IO.File]::ReadAllBytes('C:\path\service-account.json'))
FIREBASE_SERVICE_ACCOUNT_KEY_BASE64=

# ── Firebase web app config ─────────────────────────────────────────
# Firebase Console → Project settings → Your apps → (your web app) → firebaseConfig
# These are safe for the browser — that's what the NEXT_PUBLIC_ prefix means.
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyBMcscnOqHI-xEtOHeHbW93Fl9Sgn6q9pU
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=capstone-week4-team30.firebaseapp.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=18158263296
NEXT_PUBLIC_FIREBASE_APP_ID=1:18158263296:web:be09d1c42572fac2754ce5
# Optional — only if Google Analytics is enabled on the web app
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ── App ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Team 30

# ── Backend API ─────────────────────────────────────────────────────
# Allowed CORS origin for /api (empty = all cross-origin requests denied)
CORS_ORIGIN=http://localhost:3000
# Local port for the Functions API
PORT=5001

# ── Claude Code MCP (optional) ──────────────────────────────────────
# Not needed to run the app — leave blank unless you use Stitch in Claude Code.
# Google Stitch design-to-code — https://stitch.withgoogle.com/settings
STITCH_API_KEY=

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=hermes3:3b